POSTGRES_DB=resumeai
POSTGRES_USER=resumeai_user
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=django-insecure-resumeai-local-dev-key-change-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Anthropic API Key (replace with your real key from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-placeholder-key-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Redis URL for Celery
REDIS_URL=redis://127.0.0.1:6379/0

# CORS allow list for React/Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional services (can remain blank for local dev)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

